#!/bin/zsh
# Kai reprompt helper — one persistent Astra service thread.
#   kai "request"        continue the thread (starts one if none)
#   kai --new "request"  start a fresh thread
cd "${0:A:h}"
flags=(--skip-git-repo-check --dangerously-bypass-approvals-and-sandbox
  -m gpt-6-astra -c 'service_tier="fast"' -c 'model_reasoning_effort="xhigh"')
[[ "$1" == "--new" ]] && { rm -f .thread; shift; }
if [[ -s .thread ]]; then
  codex exec "${flags[@]}" resume "$(cat .thread)" "$*" < /dev/null
else
  codex exec "${flags[@]}" "$*" < /dev/null | tee .last.log
  grep -m1 -oE 'session id: [0-9a-f-]+' .last.log | cut -d' ' -f3 > .thread
fi
